{
  "name": "treehouse-photography-upload",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-11",
  "vars": {
    "GITHUB_OWNER": "pan1ctreeh0useboy",
    "GITHUB_REPO": "pan1ctreeh0useboy.github.io",
    "GITHUB_BRANCH": "main",
    "ALLOWED_ORIGINS": "https://pan1ctreeh0useboy.github.io"
  },
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "101", "simple": { "limit": 5, "period": 60 } },
    { "name": "UPLOAD_LIMITER", "namespace_id": "102", "simple": { "limit": 10, "period": 60 } }
  ]
}
